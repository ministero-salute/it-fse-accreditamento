									</observation>
							</entryRelationship>
						</act> 
					</entry>
				</section>
			</component>
			<component typeCode="COMP">
				<section ID="RIFERIMENTO_INVITO_PRECEDENTE">
					<templateId root="2.16.840.1.113883.3.1937.777.63.10.680" />
					<code code="55107-7" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="External Documents" />
					<title> Documenti esterni correlati</title>
					<text>
					Gentile Signora,
					abbiamo gi√† spedito un primo invito per eseguire le vaccinazioni. Non avendo ricevuto risposta, abbiamo 
					prenotato un nuovo appuntamento
					
					Le proponiamo un appuntamento per il: 20 Luglio 2025 alle ore: 09:00 presso: la sede ASL Roma 2. La vaccinazione √® gratuita e non occorre la prescrizione del medico di famiglia.
					</text>
