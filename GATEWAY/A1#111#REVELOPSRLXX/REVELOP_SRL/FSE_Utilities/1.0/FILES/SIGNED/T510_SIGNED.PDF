	<component>
		<structuredBody moodCode="EVN" classCode="DOCBODY">
			<component>
				<section ID="VACCINAZIONE">
					<templateId root="2.16.840.1.113883.3.1937.777.63.10.944" />
					<code code="112069-0" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Immunization invitation letter [Text] Narrative Preventive medicine" />
					<title>Vaccinazione </title>
					<text> 
						<paragraph> 
					Vi invitiamo a presentarvi per la somministrazione delle vaccinazioni di seguito elencate:
						1¬∞ - TETANO
						1¬∞ - DIFTERITE
						1¬∞ - PERTOSSE
					presso Sede Vaccinale dell'ASL ROMA 2, giorno 30/06/2025  alle ore  10:30
					Si prega di comunicare il motivo per cui non ci si pu√≤ presentare,Sar√† cos√¨ possibile prendere subito un altro appuntamento.
						</paragraph> 
					</text>
