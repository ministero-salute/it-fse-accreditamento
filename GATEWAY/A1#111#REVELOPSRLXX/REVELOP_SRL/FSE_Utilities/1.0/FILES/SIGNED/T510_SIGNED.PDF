										<value xsi:type="CD" code="V06.1" codeSystem="2.16.840.1.113883.6.103" codeSystemName="ICD-9-CM" displayName="Difterite-tetano-pertosse" />
									<entryRelationship typeCode="RSON" inversionInd="false">
										<observation classCode="OBS" moodCode="EVN">
											<templateId root="2.16.840.1.113883.3.1937.777.63.10.672" />
											<code code="30973-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Numero di Dose" />
											<value xsi:type="INT" value="1" />
