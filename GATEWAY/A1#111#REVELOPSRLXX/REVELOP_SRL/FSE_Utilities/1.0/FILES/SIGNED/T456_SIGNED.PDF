<!--VACCINAZIONI BODY CDA2-->

	<component typeCode="COMP" contextConductionInd="true">
		<structuredBody moodCode="EVN" classCode="DOCBODY">
			<component typeCode="COMP" contextConductionInd="true">
				<section classCode="DOCSECT" moodCode="EVN" ID="Singola_Vaccinazione">
					<templateId root="2.16.840.1.113883.2.9.10.1.11.3.1"/>					
					<id root="XXX"/>
					<code code="11369-6" displayName="Storia delle immunizzazioni" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 	
					<title> Scheda della singola Vaccinazione </title>
					<text>
						[NARRATIVE_BLOCK]
					</text>
					<!--dati vaccinazione-->
					<entry> 
						<substanceAdministration moodCode="EVN" classCode="SBADM">
							<templateId root="2.16.840.1.113883.2.9.10.1.11.4.1"/>
							<statusCode code="completed"/>
							<effectiveTime value="20220330101000+0100"/>
							<routeCode code="IABDINJ" codeSystem="2.16.840.1.113883.5.112" codeSystemName=" HL7 RouteOfAdministration" displayName="Injection, intra-abdominal"/>
							<approachSiteCode code="LA" codeSystem="2.16.840.1.113883.5.1052" codeSystemName="ActSite" displayName="left arm"/>
							<doseQuantity value="20" unit="mL"/> 
							<consumable typeCode="CSM">
								<manufacturedProduct>
									<manufacturedMaterial>
										<code code="035606033" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="ARIXTRA*2,5MG/0,5MLSC 10SIR.">
											<translation code="B01AX05" codeSystem="2.16.840.1.113883.6.73" codeSystemName="ATC" displayName="FONDAPARINUX"/> 
										</code>
										<lotNumberText>20</lotNumberText>
									</manufacturedMaterial>
									<manufacturerOrganization>
										<id root="1.1.1.1.1.1.1.1" extension="999999" assigningAuthorityName="[NOME_AUTHORITY]"/>
										<name>XXX</name>
									</manufacturerOrganization>
								</manufacturedProduct>
							</consumable>
							<!--Numero di dose-->
							<entryRelationship typeCode="SUBJ" inversionInd="true">
								<observation classCode="OBS" moodCode="EVN">
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.3"/>
									<code code="30973-2" displayName="Numero di dose" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/>
									<statusCode code="completed"/>
									<value xsi:type="INT" value="3"/>
								</observation>
							</entryRelationship>
							<!--Periodo di copertura-->
							<entryRelationship typeCode="REFR" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.4"/> 
									<code code="59778-1" codeSystem="2.16.840.1.113883.4.642.3.308" codeSystemName="ImmunizationRecommendationDateCriterionCodes" displayName="Date when overdue for immunization"/>
									<statusCode code="completed"/>
									<value xsi:type="IVL_TS"> 
										<high value="20220301221122+0100"/>
									</value>
								</observation>
							</entryRelationship>
							<!--Categorie a rischio-->
							<entryRelationship typeCode="RSON" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.5"/>
									<code codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" code="95715-9" displayName="Categorie a rischio"/>
									<statusCode code="completed"/> 
									<value xsi:type="CD" codeSystem="2.16.840.1.113883.2.9.6.1.56.2" codeSystemName="Categorie di Rischio" code="01" displayName="Nessuna Indicazione"/>
								</observation>
							</entryRelationship>
							<!--Condizioni sanitarie a rischio-->
							<entryRelationship typeCode="RSON" inversionInd="false">    
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.6"/>
									<code code="59785-6" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Indicazioni per la vaccinazione"/>
									<statusCode code="completed"/> 
									<value xsi:type="CD"  code="493.9" codeSystem="2.16.840.1.113883.6.103" displayName="bronchite asmatica (acuta)" codeSystemName="ICD-9CM (diagnosis codes)"> <!--Da eliminare?-->
										<originalText> 
											<reference value="#[REF_CONSRISK]"/> 
										</originalText> 
									</value> 
								</observation>	
							</entryRelationship>
							<!--Reazioni avverse-->
							<entryRelationship typeCode="CAUS" inversionInd="false">   
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.8"/> 
									<code code="31044-1" displayName="Reazione alla Vaccinazione" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 
									<statusCode code="completed"/> 
									<effectiveTime>
										<low value="20220427101010+0100"/>
										<high value ="20220506101010+0100"/>
									</effectiveTime>
									<value xsi:type="CD" code="692.3" codeSystem="2.16.840.1.113883.6.103" displayName="Dermatite da contatto con farmaci" codeSystemName="ICD-9CM (diagnosis codes)"> <!--Da eliminare?-->
										<originalText>
											<reference value="#[REF_REAZ]"/> 
										</originalText>
									</value>
								</observation>
							</entryRelationship>
							<!--Malattia per cui si effettua la vaccinazione-->
							<entryRelationship typeCode="RSON" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.9"/> 
									<code code="75323-6" displayName="Condizione" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 
									<statusCode code="completed"/> 
									<value xsi:type="CD" code="99.45" codeSystem="2.16.840.1.113883.6.103" codeSystemName="ICD-9CM" displayName="Morbillo">
										<originalText>
											<reference value="#[REF_MAL]"></reference>
										</originalText>
									</value>
								</observation>
							</entryRelationship>
						</substanceAdministration>
					</entry>	
					
				</section>
			</component>
		</structuredBody>
	</component>
</ClinicalDocument>	



