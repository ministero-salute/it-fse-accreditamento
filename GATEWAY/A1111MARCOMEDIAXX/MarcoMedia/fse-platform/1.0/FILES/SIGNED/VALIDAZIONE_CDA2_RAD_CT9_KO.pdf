							</thead>
							<tbody>
								<tr>
									<td>Radiografia del torace</td>
									<td>(03 Feb2022 09:22)</td>
									<td>Nessun trauma riscontrato</td>
								</tr>
							</tbody>
						</table>
					</text>
					<entry>
						<observation classCode="OBS" moodCode="EVN">
							<code code="36554-4" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Radiografia del torace"/>
