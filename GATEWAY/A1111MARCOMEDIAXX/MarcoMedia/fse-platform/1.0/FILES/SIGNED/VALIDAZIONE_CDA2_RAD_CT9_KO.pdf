				<section ID="ESAME_ESEGUITO">
					<code code="55111-9" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Descrizioni attuale procedure di imaging"/>
					<title>Esame Eseguito</title>
					<text>
						<table>
							<thead>
								<tr>
									<th>Descrizione Esame Eseguito</th>
									<th>Data Esame Eseguito</th>
									<th>Modalit&#xE0; Esame Eseguito</th>
									<th>Dose Assorbita</th>
								</tr>
							</thead>
							<tbody>
								<tr ID="Esame1">
									<td ID="EsameDesc1">Radiografia del torace</td>
									<td>(03 Feb2022 09:22)</td>
									<td>Procedura radiografica del torace</td>
									<td>0,001mSv</td>
								</tr>
							</tbody>
						</table>
					</text>
					<entry>
						<act moodCode="EVN" classCode="ACT">
							<code code="87.3" displayName="Soft tissue x-ray of thorax" codeSystem="2.16.840.1.113883.6.103" codeSystemName="ICD-9-CM">
								<originalText>
									<reference value="#EsameDesc1"/>
								</originalText>
