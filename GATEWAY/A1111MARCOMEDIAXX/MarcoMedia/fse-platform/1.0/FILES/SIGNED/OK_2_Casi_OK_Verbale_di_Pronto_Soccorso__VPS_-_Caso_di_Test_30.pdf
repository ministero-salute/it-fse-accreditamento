											<templateId root="2.16.840.1.113883.2.9.10.1.6.64"/>
											<id root="2.16.840.1.113883.2.9.4.1.1" extension="IDSTRUTTURA" assigningAuthorityName="[NOME_ORGANIZZAZIONE]"/>
											<code code="5" codeSystem="2.16.840.1.113883.2.9.1.11.1.2.11" codeSystemName="TipoLuogoPostDimissione_VPS" displayName="rifiuto ricovero"/>
										</participantRole>
