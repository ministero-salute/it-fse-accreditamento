<!--VACCINAZIONI BODY CDA2-->

	<component typeCode="COMP" contextConductionInd="true">
		<structuredBody moodCode="EVN" classCode="DOCBODY">
			<component typeCode="COMP" contextConductionInd="true">
				<section classCode="DOCSECT" moodCode="EVN" ID="Singola_Vaccinazione">
					<templateId root="2.16.840.1.113883.2.9.10.1.11.3.1"/>					
					<id root="XXX"/>
					<code code="11369-6" displayName="Storia delle immunizzazioni" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 	
					<title> Scheda della singola Vaccinazione </title>
					<text>
						[NARRATIVE_BLOCK]
					</text>
					<!--dati vaccinazione-->
					<entry> 
						<substanceAdministration moodCode="EVN" classCode="SBADM">
							<templateId root="2.16.840.1.113883.2.9.10.1.11.4.1"/>
							<statusCode code="completed"/>
							<effectiveTime value="20220330101000+0100"/>
							<routeCode code="IABDINJ" codeSystem="2.16.840.1.113883.5.112" codeSystemName=" HL7 RouteOfAdministration" displayName="Injection, intra-abdominal"/>
							<approachSiteCode code="LA" codeSystem="2.16.840.1.113883.5.1052" codeSystemName="ActSite" displayName="left arm"/>
							<doseQuantity value="20" unit="mL"/>
							<consumable typeCode="CSM">
								<manufacturedProduct>
									<manufacturedMaterial>
										<code code="035606033" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="ARIXTRA*2,5MG/0,5MLSC 10SIR.">
											<translation code="B01AX05" codeSystem="2.16.840.1.113883.6.73" codeSystemName="ATC" displayName="FONDAPARINUX"/>
										</code>
									</manufacturedMaterial>
								</manufacturedProduct>
							</consumable>
							<participant typeCode="LOC">
								<participantRole classCode="ROL">
									<id root="2.16.840.1.113883.2.9.4.1.2" extension="120148" assigningAuthorityName="Ministero della Salute"/>	
								</participantRole>
							</participant>
							<!--numero di dose-->
							<entryRelationship typeCode="SUBJ" inversionInd="true">  
								<observation classCode="OBS" moodCode="EVN">
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.3"/> 
									<code code="30973-2" displayName="Numero di dose" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 
									<statusCode code="completed"/> 
									<value xsi:type="INT" value="3"/> 
								</observation>
							</entryRelationship>
							<!--periodo di copertura-->
							<entryRelationship typeCode="REFR" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.4"/> 
									<code code="59778-1" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Date when overdue for immunization "/> 
									<statusCode code="completed"/>
									<value xsi:type="IVL_TS">
										<high value="20220301221122+0100"/>
									</value>
								</observation>
							</entryRelationship>
							<!--schedulazione del prossimo vaccino-->
							<entryRelationship typeCode="REFR" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN"> 
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.4"/> 
									<code code="30980-7" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Date vaccine due"/> 
									<statusCode code="completed"/> 
									<value xsi:type="TS" value="20220308221122+0100"/>
								</observation>
							</entryRelationship>
						</substanceAdministration>
					</entry>	
					<!--dati esonero/omissione o differimento-->
					<!--entry-->  
						<!--substanceAdministration moodCode="EVN" classCode="SBADM">
							<templateId root="2.16.840.1.113883.2.9.10.1.11.4.2"/>
							<statusCode code="cancelled"/>
							<effectiveTime value="20220410222222+0100"/>
							<consumable typeCode="CSM">
								<manufacturedProduct>
									<manufacturedMaterial>
										<code code="043348022" displayName="[DESC_AIC_VACC]" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC">
											<translation code="C08CA01" displayName="[DESC_ATC_VACC]" codeSystem="2.16.840.1.113883.6.73" codeSystemName="ATC"/>
										</code>
									</manufacturedMaterial>
								</manufacturedProduct>
							</consumable>
							<participant typeCode="LOC">
								<participantRole classCode="ROL">
									<id root="XXX" extension="999999" assigningAuthorityName="[NOME_AUTHORITY]"/>
								</participantRole>
							</participant-->
							<!--numero di dose-->
							<!--entryRelationship typeCode="SUBJ" inversionInd="true">  
								<observation classCode="OBS" moodCode="EVN">
									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.3"/> 
									<code code="30973-2" displayName="Numero di dose" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/> 
									<statusCode code="completed"/> 
