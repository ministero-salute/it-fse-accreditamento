									<templateId root="2.16.840.1.113883.2.9.10.1.11.4.10"/>
									<code code="85714-4" displayName="Motivo per cui non si √® ricevuto vaccino" codeSystemName="HL7 ActNoImmunizationReason" codeSystem="2.16.840.1.113883.6.1"/>
									<statusCode code="completed"/>
									<effectiveTime>
										<low value="20220425121122+0100"/>
