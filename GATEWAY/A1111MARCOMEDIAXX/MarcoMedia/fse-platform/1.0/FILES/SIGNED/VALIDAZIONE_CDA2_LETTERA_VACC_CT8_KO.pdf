	<!--BODY LETTERA-->
	<!--Livello di Vaccinazione-->

	<component>
		<structuredBody moodCode="EVN" classCode="DOCBODY">
			<component>
				<section ID="VACCINAZIONE">
					<templateId root="2.16.840.1.113883.3.1937.777.63.10.944"/>
					<code code="112069-0" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Immunization invitation letter [Text] Narrative Preventive medicine"/>
					<title>Vaccinazione </title>
					<text> 
						<paragraph> 
					Vi invitiamo a presentarvi per la somministrazione delle vaccinazioni di seguito elencate:
						1&#xB0; - TETANO
						1&#xB0; - DIFTERITE
						1&#xB0; - PERTOSSE
					presso Sede Vaccinale dell'ASL ROMA 2, giorno 30/06/2025  alle ore  10:30
					Si prega di comunicare il motivo per cui non ci si pu&#xF2; presentare,Sar&#xE0; cos&#xEC; possibile prendere subito un altro appuntamento.
						</paragraph> 
					</text>
					<entry>
						<encounter moodCode="APT">
							<effectiveTime value="20250603010309+0100"/>
							<participant typeCode="LOC">
								<participantRole classCode="SDLOC">
									<id root="2.16.840.1.113883.2.9.4.1.1" extension="120202" assigningAuthorityName="Ministero della Salute"/>
									<addr use="WP">
										<country>100</country>
										<state>120</state>
										<county>RM</county>
										<city>Roma</city>
										<censusTract>15146</censusTract>
										<postalCode>20129</postalCode>
										<streetAddressLine>via Goffredo Mameli 2</streetAddressLine>
									</addr>
									<telecom use="WP" value="mailto:prova.provax@example.com"/>
									<playingEntity>
										<name>ASL Roma 2</name>
									</playingEntity>	
								</participantRole>
							</participant>
							<entryRelationship typeCode="COMP" inversionInd="false"> 
								<observation classCode="OBS" moodCode="EVN">
									<code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4" codeSystemName="ActCode" displayName="Assertion"/>
									<text>
										Per contattare la struttura scrivere all'email prova.provax@example.com o contattare il numero 061111111
									</text>
								</observation>
							</entryRelationship>
						</encounter>
					</entry>
					<entry> 
						<act classCode="ACT" moodCode="EVN"> 
						<templateId root="2.16.840.1.113883.3.1937.777.63.10.945"/>
							<code code="112072-4" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Immunization letter Preventive medicine"/>
							<text> 
									[TEXT]
							</text>
							<effectiveTime value="20220509073749+0100"/>
							<entryRelationship typeCode="RSON" inversionInd="false">
									<observation classCode="OBS" moodCode="EVN">
										<templateId root="2.16.840.1.113883.3.1937.777.63.10.675"/>
										<code code="75323-6" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Condizione"/>
										<value xsi:type="CD" code="ZZZ-INVALID" codeSystem="2.16.840.1.113883.6.103" codeSystemName="ICD-9-CM" displayName="Difterite-tetano-pertosse"/>
									<entryRelationship typeCode="RSON" inversionInd="false">
										<observation classCode="OBS" moodCode="EVN">
											<templateId root="2.16.840.1.113883.3.1937.777.63.10.672"/>
											<code code="30973-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Numero di Dose"/>
											<value xsi:type="INT" value="1"/>
										</observation>
									</entryRelationship>										
									</observation>
							</entryRelationship>
						</act> 
					</entry>
				</section>
			</component>
			<component typeCode="COMP">
				<section ID="RIFERIMENTO_INVITO_PRECEDENTE">
					<templateId root="2.16.840.1.113883.3.1937.777.63.10.680"/>
					<code code="55107-7" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="External Documents"/>
					<title> Documenti esterni correlati</title>
					<text>
					Gentile Signora,
					abbiamo gi&#xE0; spedito un primo invito per eseguire le vaccinazioni. Non avendo ricevuto risposta, abbiamo 
					prenotato un nuovo appuntamento
					
					Le proponiamo un appuntamento per il: 20 Luglio 2025 alle ore: 09:00 presso: la sede ASL Roma 2. La vaccinazione &#xE8; gratuita e non occorre la prescrizione del medico di famiglia.
					</text>
					<entry typeCode="COMP">
						<act classCode="ACT" moodCode="EVN"> 
						<templateId root="2.16.840.1.113883.3.1937.777.63.10.679"/>
							<code code="55107-7" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="External Documents"/>
							<effectiveTime value="20220509073749+0100"/>
							<reference typeCode="REFR">
								<externalDocument classCode="DOCCLIN" moodCode="EVN">
								<id root="2.16.840.1.113883.9.9.9.9" extension="849347374" assigningAuthorityName="TEST"/>
								</externalDocument>
							</reference>
						</act>	
					</entry>
						<entry>
						<act classCode="ACT" moodCode="EVN"> 
						<templateId root="2.16.840.1.113883.3.1937.777.63.10.679"/>
							<code code="55107-7" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="External documents"/>
							<effectiveTime value="20220509073749+0100"/>
							<reference typeCode="REFR">
								<externalDocument classCode="DOCCLIN" moodCode="EVN">
								<id root="2.16.840.1.113883.9.9.9.9" extension="849347374" assigningAuthorityName="TEST"/>
								</externalDocument>
							</reference>
						</act>	
					</entry>
				</section>
			</component>			
		</structuredBody>
	</component>	
</ClinicalDocument>

