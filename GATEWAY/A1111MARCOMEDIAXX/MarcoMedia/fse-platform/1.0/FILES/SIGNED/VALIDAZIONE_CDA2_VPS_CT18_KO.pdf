					<title> Terapia farmacologica alla dimissione</title>
					<text>
						Dal 1/7 al 7/7: Losaprex 50 mg 1 cpr ore 8
						Dal 1/7 al 7/7: Cardicor 5 mg 1 cpr ore 8 Dal 1/7 al 7/7: Lasix 25 
						mg 2 cpr ore 8
						Dal 1/7 al 7/7: Peptazol 40 mg 1 cpr ore 20
						Dal 1/7 al 7/7: Arixtra 2.5 mg 1 fl s.c. ore 20
						Dal 1/7 al 7/7: Coumadin sec INR (range terapeutico 2-3)
					</text>
					<author>
						<time value="20220428101010+0100"/>
						<assignedAuthor>
							<id root="2.16.840.1.113883.2.9.4.3.2" extension="PROVAX00X00X000Y" assigningAuthorityName="MEF"/>
