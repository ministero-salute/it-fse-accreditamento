			<component typeCode="COMP">
				<section ID="TERAPIA_FARMACOLOGICA_EFFETTUATA_DURANTE_RICOVERO">
					<code code="10160-0" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Terapie Farmacologiche"/>
					<title>Terapia farmacologica effettuata durante il ricovero</title>
					<text>
						Dal 21/03 al 17/04: Losaprex 50 mg 1 cpr ore 8
						Dal 21/03 al 17/04: Cardicor 5 mg 1 cpr ore 8
						Dal 21/03 al 17/04: Lasix 25 mg 2 cpr ore 8
						Dal 21/03 al 17/04: Peptazol 40 mg 1 cpr ore 20
						Dal 21/03 al 17/04: Arixtra 2.5 mg 1 fl s.c. ore 20
						Dal 21/03 al 17/04: Coumadin sec INR (range terapeutico 2-3)
					</text>
					<entry>
						<substanceAdministration classCode="SBADM" moodCode="EVN">
							<text> 
								<reference value="#[REF_MED]"/>
							</text>
							<statusCode code="completed"/>
							<effectiveTime xsi:type="IVL_TS">
								<low value="20220321000000+0100"/>
								<high value="20220417100000+0100"/>
							</effectiveTime>
							<!-- Posologia -->
							<effectiveTime operator="A" xsi:type="PIVL_TS" institutionSpecified="true">
								<period value="12" unit="h"/>
							</effectiveTime>
							<!-- Via di somministrazione -->
							<routeCode code="IABDINJ" codeSystem="2.16.840.1.113883.5.112" codeSystemName="HL7 RouteOfAdministration" displayName="Injection, intra-abdominal"/>
							<!-- Sito di somministrazione-->
							<approachSiteCode code="LA" codeSystem="2.16.840.1.113883.5.1052" codeSystemName="ActSite" displayName="left arm"/>
							<!--  Dose-->
							<doseQuantity>
								<low value="20" unit="mL"/>
								<high value="30" unit="mL"/> 
							</doseQuantity>
							<!-- Frequenza di erogazione -->
							<rateQuantity>
								<low value="10" unit="mL/h"/>
								<high value="15" unit="mL/h"/> 
							</rateQuantity>
							<!-- Forma Farmaceutica -->
							<administrationUnitCode code="385219001" codeSystem="2.16.840.1.113883.6.96" codeSystemName="SNOMED" displayName="Injection solution"/>
							<!-- ATC / AIC -->
							<consumable>
								<manufacturedProduct classCode="MANU">
									<manufacturedMaterial>
										<code code="035606033" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="ARIXTRA*2,5MG/0,5MLSC 10SIR.">
											<originalText>
												<reference value="#[REF_FARMACO]"/>
											</originalText>
											<translation code="B01AX05" codeSystem="2.16.840.1.113883.6.73" codeSystemName="WHO ATC" displayName="FONDAPARINUX"/>
										</code>
									</manufacturedMaterial>
								</manufacturedProduct>
							</consumable>
							<performer>
								<time value="20220402221122+0100"/>
								<assignedEntity>
									<id root="2.16.840.1.113883.2.9.4.3.2" extension="PROVAX00X00X000Y" assigningAuthorityName="MEF"/>
									<assignedPerson>
										<name>
											<family>Esempio</family>
											<given>Test</given>
										</name>
									</assignedPerson>
								</assignedEntity>
							</performer>
							<participant typeCode="DIR">
								<time value="20220301221122+0100"/>
								<participantRole>
									<id root="2.16.840.1.113883.2.9.4.3.2" extension="PROVAX00X00X000Y" assigningAuthorityName="MEF"/>
									<playingEntity>
										<name>
											<family>Esempio</family>
											<given>Test</given>
										</name>
									</playingEntity>
								</participantRole>
							</participant>
	
							<!-- GRAMMATURA -->
							<entryRelationship typeCode="COMP">
								<observation classCode="OBS" moodCode="EVN">
									<code code="037485075" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="Grammatura"/>
									<value xsi:type="REAL" value="2.5"/>
								</observation>
							</entryRelationship>
							<!-- QUANTIT√Ä NELLA CONFEZIONE -->
							<!--entryRelationship typeCode="COMP">
								<observation classCode="OBS" moodCode="EVN">
									<code code="[COD_QUANTIT√Ä]" codeSystem="[OID_CODESYSTEM_QUANT]" codeSystemName="[DESC_CODESYSTEM_QUANT]" displayName="Quantit√† nella Confezione"/>
									<value xsi:type="REAL" value="[QUANTITA‚Äô]"/>
								</observation>
							</entryRelationship-->	
							<!-- NUMERO DI CONFEZIONI -->
							<!--entryRelationship typeCode="COMP">
