									<quantity value="[NUMERO]"/>
								</supply>
							</entryRelationship-->								
						</substanceAdministration>
					</entry>
				</section>
			</component>

			<component typeCode="COMP">
				<section ID="CONDIZIONI_PAZIENTE_DIAGNOSI_DIMISSIONE">
					<code code="11535-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Diagnosi di Dimissione"/>
					<title>Condizioni del paziente e diagnosi alla dimissione</title>
					<text>
						Paziente in cattivo compenso emodinamico per insufficenza della Valvola 
						Aortica di grado severo. Non in grado di deambulare correttamente, 
						necessita di sedia a rotelle in ore serali. Si segnala inizio di sindrome 
						paranoica e COPD.
					</text>
					<entry>
						<observation classCode="OBS" moodCode="EVN">
							<code code="8651-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Diagnosi di Dimissione Ospedaliera"/>
							<value xsi:type="CD" code="428.0" codeSystem="2.16.840.1.113883.6.103" codeSystemName="ICD9CM" displayName="Insufficienza cardiaca">
								<translation code="67502-5" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Cardiac arrest"/>
							</value>
						</observation>
					</entry>
				</section>
			</component>
			
			<component typeCode="COMP">
				<section ID="TERAPIA_FARMACOLOGICA_DIMISSIONE">
					<code code="10183-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Terapia Farmacologica alla dimissione"/>
					<title>Terapia farmacologica alla dimissione</title>
					<text>
						<list>
							<item>Norvasc 5 mg 1 cp ore 20</item>
							<item>Cardioaspirina 100 mg 1 cp ore 12</item>
							<item>Lasix 25 mg 1 cp il Lun e Ven ore 8</item>
							<item>Karvea 150 mg 1 cp ore 8</item>
							<item>Dilatrend 6,25 mg 1/2 cp x 2 ore 8-20</item>
							<item>Terapia insulinica come da schema domiciliare</item>
							<item>Fragmin 0,6 ml 1 fl ore 8 fino a INR &gt; 2</item>
							<item>Coumadin sec INR con range 2-3</item>
						</list>
					</text>
					<entry>
						<substanceAdministration classCode="SBADM" moodCode="INT">
							<text> 
								<reference value="#[REF_MED]"/>
							</text>
							<statusCode code="active"/>
							<effectiveTime xsi:type="IVL_TS">
								<low value="20220420000000+0100"/>
								<!--high value="20210707221122+0100"/-->
							</effectiveTime>
							<!-- Posologia -->
							<effectiveTime operator="A" xsi:type="PIVL_TS" institutionSpecified="true">
								<period value="12" unit="h"/>
							</effectiveTime>
							<!-- Via di somministrazione -->
							<routeCode code="PO" codeSystem="2.16.840.1.113883.5.112" codeSystemName="HL7 RouteOfAdministration" displayName="Swallow,oral"/>
							<!-- Sito di somministrazione-->
							<!--approachSiteCode code="LA" codeSystem="2.16.840.1.113883.5.1052" codeSystemName="ActSite" displayName="left arm"/-->
							<!--  Dose-->
							<doseQuantity>
								<low value="5" unit="mg"/>
								<high value="10" unit="mg"/> 
							</doseQuantity>
							<!-- Frequenza di erogazione -->
							<rateQuantity>
								<low value="0.5" unit="mg/h"/>
								<high value="1" unit="mg/h"/> 
							</rateQuantity>
							<!-- Forma Farmaceutica -->
							<administrationUnitCode code="46992007" codeSystem="2.16.840.1.113883.6.96" codeSystemName="SNOMED" displayName="Pill"/>
							<!-- ATC / AIC -->
							<consumable>
								<manufacturedProduct classCode="MANU">
									<manufacturedMaterial>
										<code code="043348022" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="NORVASC*5MG 28 CPR">
											<originalText>
												<reference value="#[REF_FARMACO]"/>
											</originalText>
											<translation code="C08CA01" codeSystem="2.16.840.1.113883.6.73" codeSystemName="WHO ATC" displayName="AMLODIPINA"/>
										</code>
									</manufacturedMaterial>
								</manufacturedProduct>
							</consumable>
							<participant typeCode="IND">
								<time value="20220426221122+0100"/>
								<participantRole>
									<id root="2.16.840.1.113883.2.9.4.3.2" extension="PROVAX00X00X000Y" assigningAuthorityName="MEF"/>
									<playingEntity>
										<name>
											<family>Esempio</family>
											<given>Test</given>
										</name>
									</playingEntity>
								</participantRole>
							</participant>
	
							<!-- GRAMMATURA -->
							<entryRelationship typeCode="COMP">
								<observation classCode="OBS" moodCode="EVN">
									<code code="029480086" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="Grammatura"/>
									<value xsi:type="REAL" value="2.5"/>
								</observation>
							</entryRelationship>
							<!-- QUANTIT√Ä NELLA CONFEZIONE -->
							<entryRelationship typeCode="COMP">
								<observation classCode="OBS" moodCode="EVN">
									<code code="029480086" codeSystem="2.16.840.1.113883.2.9.6.1.5" codeSystemName="AIC" displayName="Quantit&#xE0; nella Confezione"/>
									<value xsi:type="REAL" value="50"/>
								</observation>
							</entryRelationship>	
							<!-- NUMERO DI CONFEZIONI -->
							<entryRelationship typeCode="COMP">
								<supply classCode="SPLY" moodCode="RQO">
									<quantity value="1"/>
								</supply>
							</entryRelationship>								
						</substanceAdministration>
					</entry>
				</section>
			</component>

			<component typeCode="COMP">
				<section ID="ISTRUZIONI_FOLLOWUP">
					<code code="18776-5" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Piano di cura"/>
					<title>Istruzioni di follow-up</title>
					<text> 
						<paragraph>
							Viene data indicazione a correzione della stenosi valvolare mediante 
							impianto di protesi valvolare per via percutanea. Si ritiene opportuno che 
							tale intervento venga svolto solamente dopo un intervallo di tempo 
							adeguato a permettere la stabilizzazione anatomo-funzionale della fistola 
							artero-venosa recentemente confezionata.
						</paragraph>
					</text>
				</section>
			</component>
		</structuredBody>
	</component>
