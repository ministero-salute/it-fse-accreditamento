			<component typeCode="COMP">
				<section ID="Esami_Eseguiti_Durante_il_Ricovero">
					<code code="30954-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Esami diagnostici e/o di laboratorio significativi."/>
					<title>Esami eseguiti durante il ricovero</title>
					<text>
						<table>
							<thead>
								<tr>
									<th>Esame</th>
