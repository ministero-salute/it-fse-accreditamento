							</tbody>
						</table>
					</text>
					<entry>
						<observation classCode="OBS" moodCode="EVN"> 
							<code code="24660-3" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="MRA Thoracic Aorta"/> 
